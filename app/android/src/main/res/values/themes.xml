<resources>
  <style name="Platform.Theme.Campfire" parent="@style/Theme.AppCompat.Light" />
<!--    parent="android:Theme.Material.Light" />-->

  <style name="Base.Theme.Campfire" parent="Platform.Theme.Campfire">
    <item name="android:windowActionModeOverlay">true</item>
  </style>

  <style name="Theme.Campfire" parent="Base.Theme.Campfire">
  </style>

  <style name="Theme.Campfire.NoActionBar">
    <item name="android:windowActionBar">false</item>
    <item name="android:windowNoTitle">true</item>
  </style>

  <!--
    System bar colours and light-bar flags are no longer set here: from targetSdk 35 the platform
    ignores android:statusBarColor / android:navigationBarColor, and enableEdgeToEdge() in
    MainActivity owns the transparent bars while ApplyStatusBar drives the icon appearance from the
    in-app theme.
  -->
  <style name="Theme.Campfire.Home" parent="Theme.Campfire.NoActionBar" />

  <!-- Window screens rise over the app and sink back into it, rather than sliding sideways -->
  <style name="Theme.Campfire.Window" parent="Theme.Campfire.NoActionBar">
    <item name="android:windowAnimationStyle">@style/Animation.Campfire.Window</item>
  </style>

  <style name="Animation.Campfire.Window" parent="@android:style/Animation.Activity">
    <item name="android:activityOpenEnterAnimation">@anim/window_screen_enter</item>
    <item name="android:activityOpenExitAnimation">@anim/window_screen_hold</item>
    <item name="android:activityCloseEnterAnimation">@anim/window_screen_hold</item>
    <item name="android:activityCloseExitAnimation">@anim/window_screen_exit</item>
  </style>
</resources>
