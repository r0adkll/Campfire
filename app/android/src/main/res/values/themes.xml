<resources>
  <style name="Platform.Theme.Campfire" parent="@style/Theme.AppCompat.Light" />
<!--    parent="android:Theme.Material.Light" />-->

  <style name="Base.Theme.Campfire" parent="Platform.Theme.Campfire">
    <item name="android:windowActionModeOverlay">true</item>
  </style>

  <style name="Theme.Campfire" parent="Base.Theme.Campfire">
  </style>

  <style name="Theme.Campfire.NoActionBar">
    <item name="android:windowActionBar">false</item>
    <item name="android:windowNoTitle">true</item>
  </style>

  <!--
    System bar colours and light-bar flags are no longer set here: from targetSdk 35 the platform
    ignores android:statusBarColor / android:navigationBarColor, and enableEdgeToEdge() in
    MainActivity owns the transparent bars while ApplyStatusBar drives the icon appearance from the
    in-app theme.
  -->
  <style name="Theme.Campfire.Home" parent="Theme.Campfire.NoActionBar" />
</resources>
