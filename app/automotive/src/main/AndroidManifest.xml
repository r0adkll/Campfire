<?xml version="1.0" encoding="utf-8"?>
<!--
  Campfire for Android Automotive OS. The car draws browsing and playback itself, from the media
  session in AudioPlayerService (infra/audioplayer/impl). Car apps may only show their own
  activities to sign in or change settings, while parked, so nothing here is a launcher activity
  or marked distractionOptimized: https://developer.android.com/training/cars/media/automotive-os
-->
<manifest xmlns:tools="http://schemas.android.com/tools"
  xmlns:android="http://schemas.android.com/apk/res/android">

  <uses-feature
    android:name="android.hardware.type.automotive"
    android:required="true" />

  <!--
    Play won't offer the app to cars missing a feature it requires, explicitly or implied by a
    permission, so none of these may be required.
  -->
  <uses-feature
    android:name="android.hardware.wifi"
    android:required="false" />
  <uses-feature
    android:name="android.hardware.screen.portrait"
    android:required="false" />
  <uses-feature
    android:name="android.hardware.screen.landscape"
    android:required="false" />
  <uses-feature
    android:name="android.hardware.camera"
    android:required="false" />

  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

  <!-- Scanning a setup QR code needs the camera, and cars don't scan -->
  <uses-permission
    android:name="android.permission.CAMERA"
    tools:node="remove" />

  <application
    android:name=".CampfireAutomotiveApplication"
    android:appCategory="audio"
    android:allowBackup="true"
    android:dataExtractionRules="@xml/data_extraction_rules"
    android:backupAgent="app.campfire.settings.SettingsBackupAgent"
    android:fullBackupOnly="true"
    android:supportsRtl="true"
    android:theme="@style/Theme.Campfire"
    android:icon="@mipmap/ic_launcher"
    android:label="@string/app_name"
    android:enableOnBackInvokedCallback="true"
    android:usesCleartextTraffic="true"
    android:networkSecurityConfig="@xml/network_security_config"
    android:largeHeap="true">

    <meta-data
      android:name="com.android.automotive"
      android:resource="@xml/automotive_app_desc" />

    <!-- Android Auto's declaration, for the phone app projecting to a car. Not for Automotive OS. -->
    <meta-data
      android:name="com.google.android.gms.car.application"
      tools:node="remove" />

    <!-- Firebase starts from FirebaseInitializer, in release builds only, as on phones -->
    <provider
      android:name="com.google.firebase.provider.FirebaseInitProvider"
      android:authorities="${applicationId}.firebaseinitprovider"
      tools:node="remove" />

    <!-- Cars have no home screen widgets -->
    <receiver
      android:name="app.campfire.widgets.PlayerWidgetReceiver"
      tools:node="remove" />

    <!-- Opened from the car's "Sign in" button, while nobody is signed in -->
    <activity
      android:name=".SignInActivity"
      android:exported="false"
      android:theme="@style/Theme.Campfire.Home"
      android:launchMode="singleTask"
      android:windowSoftInputMode="adjustResize" />

    <!--
      Opened from the settings button the car's media app shows for Campfire. Exported so the car
      can open it; it reads nothing from the intent.
    -->
    <activity
      android:name=".SettingsActivity"
      android:exported="true"
      android:label="@string/car_settings_label"
      android:theme="@style/Theme.Campfire.Home"
      android:launchMode="singleTask"
      android:windowSoftInputMode="adjustResize">
      <intent-filter>
        <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
        <category android:name="android.intent.category.DEFAULT" />
      </intent-filter>
    </activity>

  </application>
</manifest>
