{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "baseBranches": [
    "main"
  ],
  "assignees": [
    "r0adkll"
  ],
  "addLabels": [
    "renovate"
  ],
  "packageRules": [
    {
      "groupName": "Kotlin, KSP and Compose Compiler",
      "groupSlug": "kotlin",
      "matchPackageNames": [
        "com.google.devtools.ksp",
        "androidx.compose.compiler",
        "org.jetbrains.kotlin"
      ]
    },
    {
      "description": "Automatically merge minor and patch-level updates",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Disable updates to SNAPSHOTS",
      "matchDatasources": [
        "maven"
      ],
      "allowedVersions": "!/SNAPSHOT$/"
    },
    {
      "description": "Restrict Compose dependencies to stable, alpha, beta, and rc releases only (no dev or other pre-releases)",
      "matchPackageNames": [
        "/^org\\.jetbrains\\.compose(\\.|:|$)/",
        "/^org\\.jetbrains\\.androidx\\.navigationevent(\\.|:|$)/",
        "/^androidx\\.compose(\\.|:|$)/"
      ],
      "allowedVersions": "/^\\d+(\\.\\d+)+(-(alpha|beta|rc)\\d+)?$/"
    }
  ]
}
