import app.campfire.core.model.MediaProgress.Source;
import app.campfire.core.model.MediaType;
import kotlin.Boolean;

CREATE TABLE IF NOT EXISTS mediaProgress (
  id TEXT NOT NULL,
  libraryItemId TEXT NOT NULL,
  userId TEXT NOT NULL,
  -- For books: empty string. For podcast episodes: the episode id. Together with
  -- (libraryItemId, userId) it forms the PK so per-episode progress can coexist with
  -- the parent item's row.
  episodeId TEXT NOT NULL DEFAULT '',
  mediaItemId TEXT NOT NULL,
  mediaItemType TEXT AS MediaType NOT NULL,
  duration REAL,
  progress REAL NOT NULL,
  currentTime REAL NOT NULL,
  isFinished INTEGER AS Boolean NOT NULL,
  hideFromContinueListening INTEGER AS Boolean NOT NULL,
  ebookLocation TEXT,
  ebookProgress REAL,
  lastUpdate INTEGER NOT NULL,
  startedAt INTEGER NOT NULL,
  finishedAt INTEGER,
  source TEXT AS Source NOT NULL DEFAULT "Local",
  PRIMARY KEY (libraryItemId, userId, episodeId)
);

insert:
INSERT OR REPLACE INTO mediaProgress
VALUES ?;

delete:
DELETE FROM mediaProgress
WHERE userId = ?
  AND libraryItemId = ?;

-- Per-episode delete. Use this when deleting podcast episode progress so sibling episode
-- rows on the same libraryItemId aren't clobbered. For book progress, pass episodeId = ''.
deleteForEpisode:
DELETE FROM mediaProgress
WHERE userId = :userId
  AND libraryItemId = :libraryItemId
  AND episodeId = :episodeId;

deleteForUser:
DELETE FROM mediaProgress
WHERE userId = ?;

updateCurrentTime:
UPDATE OR IGNORE mediaProgress
SET currentTime = ?,
    lastUpdate = ?
WHERE libraryItemId = ?
  AND episodeId = ?;

markFinished:
UPDATE OR IGNORE mediaProgress
SET isFinished = 1,
    progress = 1,
    currentTime = 0,
    hideFromContinueListening = 1,
    lastUpdate = :timestamp,
    finishedAt = :timestamp
WHERE userId = :userId
  AND libraryItemId = :libraryItemId
  AND episodeId = :episodeId;

markNotFinished:
UPDATE OR IGNORE mediaProgress
SET isFinished = 0,
    progress = 0,
    currentTime = 0,
    hideFromContinueListening = 1,
    lastUpdate = :timestamp,
    finishedAt = NULL
WHERE userId = :userId
  AND libraryItemId = :libraryItemId
  AND episodeId = :episodeId;

getMediaProgressId:
SELECT id FROM mediaProgress
WHERE userId = ?
  AND libraryItemId = ?
  AND episodeId = ?;

selectForLibraryItem:
SELECT * FROM mediaProgress
WHERE userId = ?
  AND libraryItemId = ?
  AND episodeId = '';

selectForLibraryItemAll:
SELECT * FROM mediaProgress
WHERE userId = ?
  AND libraryItemId = ?;

selectForEpisode:
SELECT * FROM mediaProgress
WHERE userId = ?
  AND libraryItemId = ?
  AND episodeId = ?;

selectForLibraryItems:
SELECT * FROM mediaProgress
WHERE userId = ?
  AND libraryItemId IN ?
  AND episodeId = '';

selectForUser:
SELECT * FROM mediaProgress
WHERE userId = ?;
