-- Each account keeps its own copy: accounts on the same server see the same collection ids.
CREATE TABLE IF NOT EXISTS collections (
  id TEXT NOT NULL,
  name TEXT NOT NULL,
  description TEXT,
  cover TEXT,
  coverFullPath TEXT,
  updatedAt INTEGER NOT NULL,
  createdAt INTEGER NOT NULL,

  libraryId TEXT NOT NULL,
  userId TEXT NOT NULL,

  PRIMARY KEY (id, userId),
  FOREIGN KEY (userId) REFERENCES user(id) ON DELETE CASCADE
);

insert:
INSERT OR REPLACE INTO collections
VALUES ?;

updateName:
UPDATE collections
SET name = ?,
    updatedAt = ?
WHERE id = ?
  AND userId = ?;

updateDescription:
UPDATE collections
SET description = ?,
    updatedAt = ?
WHERE id = ?
  AND userId = ?;

selectAll:
SELECT * FROM collections
WHERE userId = ?;

selectById:
SELECT * FROM collections
WHERE id = ?
  AND userId = ?;

selectByLibraryId:
SELECT * FROM collections
WHERE libraryId = ?
  AND userId = ?;

delete:
DELETE FROM collections
WHERE id = ?
  AND userId = ?;

deleteOld:
DELETE FROM collections
WHERE userId = ?
  AND id NOT IN ?;
