-- The e-book reader's per-book appearance (see readerBookSettings.sq)
CREATE TABLE IF NOT EXISTS readerBookSettings (
  userId TEXT NOT NULL,
  libraryItemId TEXT NOT NULL,
  font TEXT,
  fontScale INTEGER,
  lineHeight REAL,
  margin TEXT,
  justify INTEGER,
  hyphenate INTEGER,
  flow TEXT,
  pages TEXT,
  PRIMARY KEY (userId, libraryItemId),
  FOREIGN KEY (userId) REFERENCES user(id) ON DELETE CASCADE
);

-- An ebook's table of contents, as the reader last found it (see ebookContents.sq)
CREATE TABLE IF NOT EXISTS ebookContents (
  libraryItemId TEXT NOT NULL,
  position INTEGER NOT NULL,
  label TEXT NOT NULL,
  href TEXT NOT NULL,
  depth INTEGER NOT NULL,
  fraction REAL,
  PRIMARY KEY (libraryItemId, position)
);

-- The server-listed position of each book in a series (see seriesBookJoin.sq)
ALTER TABLE seriesBookJoin ADD COLUMN position INTEGER;

-- Each podcast's unfinished episode count, kept with the library page it loaded on (see libraryItemPage.sq)
ALTER TABLE libraryItemPageJoin ADD COLUMN numEpisodesIncomplete INTEGER;
ALTER TABLE libraryItemPageJoin ADD COLUMN numEpisodesFinishedAtLoad INTEGER;

-- Each narrator of a book, as an expanded item lists them (see media.sq)
ALTER TABLE media ADD COLUMN metadata_narrators TEXT;
