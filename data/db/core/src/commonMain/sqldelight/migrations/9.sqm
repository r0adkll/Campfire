import app.campfire.core.model.SeriesSequence;
import kotlin.Boolean;
import kotlin.Int;
import kotlin.String;
import kotlin.collections.List;

-- Series sequences on the server are free-form text and frequently fractional ("1.5",
-- "2.1"). The column was INTEGER-typed so those books lost their position and sorted to
-- the end of the series. Change it to REAL; SQLite can't alter a column type in place, so
-- rebuild the table. Child rows (chapters, tracks, files, authors) are cached server
-- data and are re-hydrated on the next sync.
CREATE TABLE media_new (
  mediaId TEXT NOT NULL PRIMARY KEY,
  coverPath TEXT,
  tags TEXT AS List<String>,
  numTracks INTEGER AS Int NOT NULL,
  numAudioFiles INTEGER AS Int NOT NULL,
  numChapters INTEGER AS Int NOT NULL,
  numMissingParts INTEGER AS Int NOT NULL,
  numInvalidAudioFiles INTEGER AS Int NOT NULL,
  durationInMillis INTEGER NOT NULL,
  sizeInBytes INTEGER NOT NULL,
  propertySize INTEGER AS Int,
  ebookFormat TEXT,

  metadata_title TEXT,
  metadata_subtitle TEXT,
  metadata_genres TEXT AS List<String>,
  metadata_publishedYear TEXT,
  metadata_publishedDate TEXT,
  metadata_publisher TEXT,
  metadata_description TEXT,
  metadata_isbn TEXT,
  metadata_asin TEXT,
  metadata_language TEXT,
  metadata_explicit INTEGER AS Boolean NOT NULL DEFAULT 0,
  metadata_abridged INTEGER AS Boolean NOT NULL DEFAULT 0,
  metadata_titleIgnorePrefix TEXT,
  metadata_authorName TEXT,
  metadata_authorNameLF TEXT,
  metadata_narratorName TEXT,
  metadata_seriesName TEXT,

  metadata_series_id TEXT,
  metadata_series_name TEXT,
  metadata_series_sequence REAL,

  libraryItemId TEXT NOT NULL,

  metadata_series TEXT AS List<SeriesSequence>,
  FOREIGN KEY (libraryItemId) REFERENCES libraryItem(id) ON DELETE CASCADE ON UPDATE NO ACTION
);

INSERT INTO media_new
SELECT mediaId, coverPath, tags, numTracks, numAudioFiles, numChapters, numMissingParts,
       numInvalidAudioFiles, durationInMillis, sizeInBytes, propertySize, ebookFormat,
       metadata_title, metadata_subtitle, metadata_genres, metadata_publishedYear,
       metadata_publishedDate, metadata_publisher, metadata_description, metadata_isbn,
       metadata_asin, metadata_language, metadata_explicit, metadata_abridged,
       metadata_titleIgnorePrefix, metadata_authorName, metadata_authorNameLF,
       metadata_narratorName, metadata_seriesName, metadata_series_id, metadata_series_name,
       CAST(metadata_series_sequence AS REAL), libraryItemId, metadata_series
FROM media;

DROP TABLE media;
ALTER TABLE media_new RENAME TO media;
