import kotlin.Boolean;
import kotlinx.datetime.LocalDateTime;

CREATE TABLE IF NOT EXISTS mediaShare (
  id TEXT NOT NULL PRIMARY KEY,
  slug TEXT NOT NULL,
  url TEXT NOT NULL,
  libraryItemId TEXT NOT NULL,
  downloadable INTEGER AS Boolean NOT NULL,
  expiresAt TEXT AS LocalDateTime NOT NULL,
  createdAt TEXT AS LocalDateTime NOT NULL,
  updatedAt TEXT AS LocalDateTime NOT NULL,

  userId TEXT NOT NULL,
  FOREIGN KEY (userId) REFERENCES user(id) ON DELETE CASCADE,
  FOREIGN KEY (libraryItemId) REFERENCES libraryItem(id)
);

-- Queries

insert:
INSERT OR REPLACE INTO mediaShare
VALUES ?;

selectAll:
SELECT * FROM mediaShare
WHERE userId = ?;

delete:
DELETE FROM mediaShare
WHERE id = ?;
