<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:tools="http://schemas.android.com/tools"
  xmlns:android="http://schemas.android.com/apk/res/android">

  <uses-permission android:name="android.permission.INTERNET" />

  <queries>
    <intent>
      <action android:name="android.intent.action.VIEW" />
      <category android:name="android.intent.category.BROWSABLE" />
      <data android:scheme="https" />
    </intent>
  </queries>

  <application>

    <!--
      Handles its own configuration changes: when it signs in in a web view (cars, devices without
      a browser), being recreated, say at a car's switch to night mode, would lose the page.
    -->
    <activity
      android:name="app.campfire.network.oidc.WebAuthActivity"
      android:exported="true"
      android:launchMode="singleTask"
      android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation|uiMode">
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />

        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />

        <!-- campfireaudiobooks://oauth -->
        <data
          android:scheme="campfireaudiobooks"
          android:host="oauth"
          />
      </intent-filter>
    </activity>

  </application>
</manifest>
