# Store publishing lanes. Building is Gradle's job (see .github/workflows/release.yml); these
# lanes only move already-built artifacts and the metadata/ listing into the stores.
#
#   fastlane android beta       aab:<path> [mapping:<path>]   rc tags   -> open testing, 100%
#   fastlane android production aab:<path> [mapping:<path>]   final tag -> production, 100%
#                               [rollout:<0..1>]              opt into a staged rollout instead
#                               [form_factor:automotive]      the Android Automotive OS bundle, to
#                                                             that form factor's own track
#   fastlane android rollout    [fraction:<0..1>]             promote an in-progress staged release
#   fastlane android metadata                                 sync listing text/images (no binaries)
#
# iOS lanes (TestFlight / App Store via pilot + deliver) will live under `platform :ios`.

require "fileutils"
require "tmpdir"

skip_docs
default_platform(:android)

ANDROID_METADATA = File.expand_path("metadata/android", __dir__)

# Mirrors AUTOMOTIVE_VERSION_CODE_OFFSET in gradle/build-logic Versioning.kt: the car build's
# versionCode is the phone's plus this.
AUTOMOTIVE_VERSION_CODE_OFFSET = 1_000_000_000

platform :android do
  desc "Release-candidate build to the open testing (beta) track"
  lane :beta do |options|
    publish(options.merge(track: "beta"))
  end

  desc "Final build to production for all users, or a staged rollout when `rollout` is passed"
  lane :production do |options|
    publish(options.merge(track: "production"))
  end

  desc "Move the in-progress production release to `fraction` of users (default 1 = complete)"
  lane :rollout do |options|
    fraction = (options[:fraction] || "1").to_s
    upload_to_play_store(
      track: "production",
      rollout: fraction,
      release_status: release_status_for(fraction),
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end

  desc "Sync the store listing (descriptions, icon, feature graphic, screenshots) from fastlane/metadata"
  lane :metadata do
    upload_to_play_store(
      metadata_path: ANDROID_METADATA,
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_changelogs: true,
    )
  end

  # The AAB's versionCode selects metadata/android/<locale>/changelogs/<versionCode>.txt as the
  # release notes, which scripts/release writes when cutting the release.
  #
  # form_factor:automotive publishes the car bundle on Play's Android Automotive OS track
  # ("automotive:<track>"), with the phone release's notes: they're written for the phone's
  # versionCode, so they're copied to the car's for the upload.
  private_lane :publish do |options|
    aab = options[:aab] || UI.user_error!("pass aab:<path to .aab>")
    mapping = options[:mapping]
    mapping = nil if mapping && !File.exist?(mapping)
    rollout = options[:rollout]&.to_s

    track = options[:track]
    metadata_path = ANDROID_METADATA
    case options[:form_factor]
    when nil
    when "automotive"
      track = "automotive:#{track}"
      metadata_path = automotive_metadata
    else
      UI.user_error!("unknown form_factor '#{options[:form_factor]}' (expected automotive)")
    end

    upload_to_play_store(
      aab: aab,
      mapping: mapping,
      track: track,
      rollout: rollout,
      release_status: rollout ? release_status_for(rollout) : "completed",
      metadata_path: metadata_path,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end
end

# A copy of the listing metadata holding only this release's notes, filed under the car build's
# versionCode so supply attaches them to the car bundle.
def automotive_metadata
  properties = File.read(File.expand_path("../gradle.properties", __dir__))
  phone_code = properties[/^campfire\.versionCode=(\d+)$/, 1]&.to_i ||
    UI.user_error!("campfire.versionCode is missing from gradle.properties")
  car_code = phone_code + AUTOMOTIVE_VERSION_CODE_OFFSET

  dir = Dir.mktmpdir("automotive-metadata")
  Dir.glob(File.join(ANDROID_METADATA, "*", "changelogs", "#{phone_code}.txt")).each do |notes|
    locale = File.basename(File.dirname(File.dirname(notes)))
    target = File.join(dir, locale, "changelogs")
    FileUtils.mkdir_p(target)
    FileUtils.cp(notes, File.join(target, "#{car_code}.txt"))
  end
  dir
end

def release_status_for(fraction)
  fraction.to_f >= 1 ? "completed" : "inProgress"
end
